{
  "bookingid": "#number",
  "roomid": "#number? _ >= 1",
  "firstname": "#string? _.length >= 3 && _.length <= 18",
  "lastname": "#string? _.length >= 3 && _.length <= 30",
  "depositpaid": "#boolean",
  "bookingdates": {
    "checkin": "#regex \\d{4}-\\d{2}-\\d{2}",
    "checkout": "#regex \\d{4}-\\d{2}-\\d{2}"
  }
}
