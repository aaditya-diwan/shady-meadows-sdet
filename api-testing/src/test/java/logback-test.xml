<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- print statements -->
    <logger name="karate.scenario" level="INFO"/>
    <!-- HTTP traffic: DEBUG = method, URL and headers; TRACE adds request/response bodies.
         Full bodies are always in target/karate-reports regardless of this level. -->
    <logger name="karate.http" level="DEBUG"/>
    <logger name="karate.runtime" level="WARN"/>
    <logger name="io.karatelabs" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
